<launch>

    <node pkg="stereo_vo" type="stereo_vo" name="vo" output="screen"
    args="$(find stereo_vo)/config/realsense_2/realsense_n3_unsync.yaml">
    </node>
    <node pkg="foxglove_bridge" type="foxglove_bridge" name="foxglove_bridge" output="log">
        <rosparam param="topic_whitelist">
          ["/ekf/ekf_odom",
           "/rosout",
           "/rosout_agg",
           "/vo/Odometry",
           ".*/traj_viz"
           ]
        </rosparam>
        <rosparam param="service_whitelist">[]</rosparam>
        <rosparam param="param_whitelist">[]</rosparam>
    </node>
    <node pkg="aug_ekf" type="aug_ekf" name="aug_ekf" output="screen">
        <remap from="~imu" to="/mavros/imu/data"/>
	
        <param name="aug_ekf/ng" type="double"  value="1.0"/>
        <param name="aug_ekf/na" type="double"  value="1.0"/>
        <param name="aug_ekf/nbg" type="double" value="0.001"/>
        <param name="aug_ekf/nba" type="double" value="0.001"/>
        <param name="aug_ekf/vo_pos" type="double" value="0.01"/>
        <param name="aug_ekf/vo_rot" type="double" value="0.01"/>
    </node>

</launch>
